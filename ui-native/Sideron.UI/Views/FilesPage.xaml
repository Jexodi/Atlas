<Page
    x:Class="Sideron.UI.Views.FilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid
        Margin="34,22,38,38">

        <Grid.RowDefinitions>
            <RowDefinition
                Height="Auto" />

            <RowDefinition
                Height="18" />

            <RowDefinition
                Height="*" />
        </Grid.RowDefinitions>

        <StackPanel
            Spacing="4">

            <TextBlock
                Text="Fichiers"
                FontFamily="Segoe UI Variable"
                FontSize="31"
                FontWeight="SemiBold"
                Foreground="{StaticResource SideronTextBrush}" />

            <TextBlock
                x:Name="WorkspacePathText"
                FontFamily="Segoe UI Variable"
                FontSize="12"
                Foreground="{StaticResource SideronSecondaryTextBrush}" />

        </StackPanel>

        <ScrollViewer
            Grid.Row="2"
            HorizontalScrollBarVisibility="Disabled">

            <StackPanel
                x:Name="FolderList"
                Spacing="10" />

        </ScrollViewer>

    </Grid>

</Page>
