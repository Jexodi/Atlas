<Page
    x:Class="Sideron.UI.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled">

        <StackPanel
            Margin="34,22,38,38"
            Spacing="22">

            <StackPanel
                Spacing="4">

                <TextBlock
                    Text="Accueil"
                    FontFamily="Segoe UI Variable"
                    FontSize="31"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource SideronTextBrush}" />

                <TextBlock
                    Text="Vue d’ensemble d’Sideron"
                    FontFamily="Segoe UI Variable"
                    FontSize="13"
                    Foreground="{StaticResource SideronSecondaryTextBrush}" />

            </StackPanel>

            <Grid
                ColumnSpacing="18">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition
                        Width="*" />

                    <ColumnDefinition
                        Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Style="{StaticResource SideronCardStyle}"
                    MinHeight="186">

                    <StackPanel
                        Spacing="14">

                        <TextBlock
                            Text="SYSTÈME"
                            FontFamily="Segoe UI Variable"
                            FontSize="11"
                            CharacterSpacing="150"
                            Foreground="{StaticResource SideronSecondaryTextBrush}" />

                        <TextBlock
                            Text="Prêt pour la connexion au Core"
                            FontFamily="Segoe UI Variable"
                            FontSize="19"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource SideronTextBrush}" />

                        <TextBlock
                            Text="Les données CPU, GPU, mémoire et stockage seront alimentées par les Skills Sideron via l’IPC local."
                            TextWrapping="Wrap"
                            FontFamily="Segoe UI Variable"
                            FontSize="13"
                            Foreground="{StaticResource SideronSecondaryTextBrush}" />

                    </StackPanel>

                </Border>

                <Border
                    Grid.Column="1"
                    Style="{StaticResource SideronCardStyle}"
                    MinHeight="186">

                    <StackPanel
                        Spacing="14">

                        <TextBlock
                            Text="RÉSEAU"
                            FontFamily="Segoe UI Variable"
                            FontSize="11"
                            CharacterSpacing="150"
                            Foreground="{StaticResource SideronSecondaryTextBrush}" />

                        <TextBlock
                            Text="Interface native active"
                            FontFamily="Segoe UI Variable"
                            FontSize="19"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource SideronTextBrush}" />

                        <TextBlock
                            Text="La future liaison Core ↔ Sideron.UI exposera ici l’état réseau sans exécuter de commande arbitraire côté interface."
                            TextWrapping="Wrap"
                            FontFamily="Segoe UI Variable"
                            FontSize="13"
                            Foreground="{StaticResource SideronSecondaryTextBrush}" />

                    </StackPanel>

                </Border>

            </Grid>

            <Border
                Style="{StaticResource SideronCardStyle}"
                MinHeight="210">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition
                            Height="Auto" />

                        <RowDefinition
                            Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Text="ACTIVITÉ SIDERON"
                        FontFamily="Segoe UI Variable"
                        FontSize="11"
                        CharacterSpacing="150"
                        Foreground="{StaticResource SideronSecondaryTextBrush}" />

                    <Grid
                        Grid.Row="1">

                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="8">

                            <Border
                                Width="240"
                                Height="2"
                                CornerRadius="1"
                                Background="#7055C8FF" />

                            <TextBlock
                                Text="Core non connecté à cette interface"
                                HorizontalAlignment="Center"
                                FontFamily="Segoe UI Variable"
                                FontSize="13"
                                Foreground="{StaticResource SideronSecondaryTextBrush}" />

                        </StackPanel>

                    </Grid>

                </Grid>

            </Border>

            <Grid
                ColumnSpacing="18">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition
                        Width="2*" />

                    <ColumnDefinition
                        Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Style="{StaticResource SideronCardStyle}"
                    MinHeight="160">

                    <StackPanel
                        Spacing="10">

                        <TextBlock
                            Text="ESPACE DE TRAVAIL"
                            FontFamily="Segoe UI Variable"
                            FontSize="11"
                            CharacterSpacing="150"
                            Foreground="{StaticResource SideronSecondaryTextBrush}" />

                        <TextBlock
                            Text="Les fichiers Sideron disposent maintenant de leur propre section."
                            FontFamily="Segoe UI Variable"
                            FontSize="17"
                            FontWeight="SemiBold"
                            TextWrapping="Wrap"
                            Foreground="{StaticResource SideronTextBrush}" />

                        <TextBlock
                            Text="L’arc de dossiers reste dans le projet mais n’est plus affiché par le Desktop."
                            TextWrapping="Wrap"
                            FontFamily="Segoe UI Variable"
                            FontSize="12"
                            Foreground="{StaticResource SideronSecondaryTextBrush}" />

                    </StackPanel>

                </Border>

                <Border
                    Grid.Column="1"
                    Style="{StaticResource SideronCardStyle}"
                    MinHeight="160">

                    <StackPanel
                        Spacing="10">

                        <TextBlock
                            Text="VERSION"
                            FontFamily="Segoe UI Variable"
                            FontSize="11"
                            CharacterSpacing="150"
                            Foreground="{StaticResource SideronSecondaryTextBrush}" />

                        <TextBlock
                            Text="3.3.6-rc.1"
                            FontFamily="Segoe UI Variable"
                            FontSize="24"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource SideronTextBrush}" />

                        <TextBlock
                            Text="UI native WinUI 3"
                            FontFamily="Segoe UI Variable"
                            FontSize="12"
                            Foreground="{StaticResource SideronSecondaryTextBrush}" />

                    </StackPanel>

                </Border>

            </Grid>

        </StackPanel>

    </ScrollViewer>

</Page>
