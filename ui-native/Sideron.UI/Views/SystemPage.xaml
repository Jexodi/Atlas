<Page
    x:Class="Sideron.UI.Views.SystemPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel
        Margin="34,22,38,38"
        Spacing="22">

        <StackPanel
            Spacing="4">

            <TextBlock
                Text="Système"
                FontFamily="Segoe UI Variable"
                FontSize="31"
                FontWeight="SemiBold"
                Foreground="{StaticResource SideronTextBrush}" />

            <TextBlock
                Text="État matériel et Windows"
                FontFamily="Segoe UI Variable"
                FontSize="13"
                Foreground="{StaticResource SideronSecondaryTextBrush}" />

        </StackPanel>

        <Border
            Style="{StaticResource SideronCardStyle}"
            MinHeight="220">

            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="10">

                <TextBlock
                    Text="Connexion au Core à venir"
                    HorizontalAlignment="Center"
                    FontFamily="Segoe UI Variable"
                    FontSize="21"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource SideronTextBrush}" />

                <TextBlock
                    Text="Cette page utilisera les Skills système et matériel déjà présents dans Sideron. L’interface native restera une couche d’affichage, pas un nouveau moteur d’administration."
                    MaxWidth="650"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    FontFamily="Segoe UI Variable"
                    FontSize="13"
                    Foreground="{StaticResource SideronSecondaryTextBrush}" />

            </StackPanel>

        </Border>

    </StackPanel>

</Page>
