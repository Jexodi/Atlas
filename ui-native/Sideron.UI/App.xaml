<Application
    x:Class="Sideron.UI.App"
    RequestedTheme="Dark"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <Application.Resources>
        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>
                <muxc:XamlControlsResources />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush
                x:Key="SideronTextBrush"
                Color="#E7F5FF" />

            <SolidColorBrush
                x:Key="SideronSecondaryTextBrush"
                Color="#8EB3C9" />

            <SolidColorBrush
                x:Key="SideronAccentBrush"
                Color="#55C8FF" />

            <SolidColorBrush
                x:Key="SideronCardBrush"
                Color="#40101B29" />

            <SolidColorBrush
                x:Key="SideronCardBorderBrush"
                Color="#405DCBFF" />

            <Style
                x:Key="SideronCardStyle"
                TargetType="Border">

                <Setter
                    Property="Background"
                    Value="{StaticResource SideronCardBrush}" />

                <Setter
                    Property="BorderBrush"
                    Value="{StaticResource SideronCardBorderBrush}" />

                <Setter
                    Property="BorderThickness"
                    Value="1" />

                <Setter
                    Property="CornerRadius"
                    Value="18" />

                <Setter
                    Property="Padding"
                    Value="22" />

            </Style>

            <Style
                x:Key="SideronExplorerIconButtonStyle"
                TargetType="Button">

                <Setter Property="MinWidth" Value="36" />
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="#181B2734" />
                <Setter Property="BorderBrush" Value="#32779EBB" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Foreground" Value="#D6ECF8" />

            </Style>

            <Style
                x:Key="SideronExplorerCommandButtonStyle"
                TargetType="Button">

                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="13,0" />
                <Setter Property="Background" Value="#181B2734" />
                <Setter Property="BorderBrush" Value="#32779EBB" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Foreground" Value="#D6ECF8" />

            </Style>

            <Style
                x:Key="SideronExplorerNavButtonStyle"
                TargetType="Button">

                <Setter Property="Height" Value="42" />
                <Setter Property="Padding" Value="13,0" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Background" Value="#00172331" />
                <Setter Property="BorderBrush" Value="#00172331" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Foreground" Value="#D6ECF8" />

            </Style>

            <Style
                x:Key="SideronExplorerRowButtonStyle"
                TargetType="Button">

                <Setter Property="Height" Value="44" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Background" Value="#071B2734" />
                <Setter Property="BorderBrush" Value="#14779EBB" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="9" />
                <Setter Property="Foreground" Value="#E7F5FF" />

            </Style>

            <Style
                x:Key="SideronExplorerTinyButtonStyle"
                TargetType="Button">

                <Setter Property="Width" Value="28" />
                <Setter Property="Height" Value="26" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="#181B2734" />
                <Setter Property="BorderBrush" Value="#26779EBB" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="7" />
                <Setter Property="Foreground" Value="#CDE6F5" />

            </Style>

        </ResourceDictionary>
    </Application.Resources>

</Application>
