<Page
    x:Class="Atlas.UI.Views.NetworkPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel
        Margin="34,22,38,38"
        Spacing="22">

        <StackPanel
            Spacing="4">

            <TextBlock
                Text="Réseau"
                FontFamily="Segoe UI Variable"
                FontSize="31"
                FontWeight="SemiBold"
                Foreground="{StaticResource AtlasTextBrush}" />

            <TextBlock
                Text="Diagnostic et connectivité"
                FontFamily="Segoe UI Variable"
                FontSize="13"
                Foreground="{StaticResource AtlasSecondaryTextBrush}" />

        </StackPanel>

        <Border
            Style="{StaticResource AtlasCardStyle}"
            MinHeight="220">

            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="10">

                <TextBlock
                    Text="Connexion au Core à venir"
                    HorizontalAlignment="Center"
                    FontFamily="Segoe UI Variable"
                    FontSize="21"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource AtlasTextBrush}" />

                <TextBlock
                    Text="Cette page recevra les données des Skills réseau existants via l’IPC local Atlas. Aucun accès réseau supplémentaire n’est ajouté à l’interface."
                    MaxWidth="650"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    FontFamily="Segoe UI Variable"
                    FontSize="13"
                    Foreground="{StaticResource AtlasSecondaryTextBrush}" />

            </StackPanel>

        </Border>

    </StackPanel>

</Page>
