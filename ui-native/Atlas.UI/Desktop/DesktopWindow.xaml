                                Foreground="#668FA7" />

                            <TextBlock
                                x:Name="WorkspacePathText"
                                Margin="10,0,8,0"
                                TextWrapping="Wrap"
                                FontSize="10"
                                Foreground="#719DB7" />

                        </StackPanel>

                    </ScrollViewer>

                    <Border
                        Grid.Column="1"
                        Width="1"
                        Background="#26575B6C" />

                    <!-- Details view -->
                    <Grid Grid.Column="2">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="34" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid
                            Grid.Row="0"
                            Padding="16,0"
                            Background="Transparent">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="380" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button
                                x:Name="SortNameButton"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="SortName_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock
                                        Text="Nom"
                                        FontSize="10"
                                        FontWeight="SemiBold"
                                        Foreground="#92B9CE" />
                                    <TextBlock
                                        x:Name="SortNameIndicator"
                                        Text="↑"
                                        FontSize="10"
                                        Foreground="#55C8FF" />
                                </StackPanel>
                            </Button>

                            <Button
                                x:Name="SortTypeButton"
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="SortType_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock
                                        Text="Type"
                                        FontSize="10"
                                        FontWeight="SemiBold"
                                        Foreground="#92B9CE" />
                                    <TextBlock
                                        x:Name="SortTypeIndicator"
                                        FontSize="10"
                                        Foreground="#55C8FF" />
                                </StackPanel>
                            </Button>

                            <Button
                                x:Name="SortModifiedButton"
                                Grid.Column="2"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="SortModified_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock
                                        Text="Modifié"
                                        FontSize="10"
                                        FontWeight="SemiBold"
                                        Foreground="#92B9CE" />
                                    <TextBlock
                                        x:Name="SortModifiedIndicator"
                                        FontSize="10"
                                        Foreground="#55C8FF" />
                                </StackPanel>
                            </Button>

                            <Button
                                x:Name="SortSizeButton"
                                Grid.Column="3"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="SortSize_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock
                                        Text="Taille"
                                        FontSize="10"
                                        FontWeight="SemiBold"
                                        Foreground="#92B9CE" />
                                    <TextBlock
                                        x:Name="SortSizeIndicator"
                                        FontSize="10"
                                        Foreground="#55C8FF" />
                                </StackPanel>
                            </Button>

                        </Grid>

                        <Grid
                            x:Name="ExplorerContentSurface"
                            Grid.Row="1"
                            Background="Transparent"
                            PointerPressed="ExplorerContentSurface_PointerPressed">

                            <ScrollViewer
                                x:Name="DetailsScroller"
                                VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Disabled">

                                <StackPanel
                                    x:Name="FolderList"
                                    Padding="10,7"
                                    Spacing="4" />

                            </ScrollViewer>

                            <GridView
                                x:Name="IconGrid"
                                Visibility="Collapsed"
                                Padding="12"
                                SelectionMode="None"
                                IsItemClickEnabled="False"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Top"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                ScrollViewer.VerticalScrollBarVisibility="Auto">

                                <GridView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsWrapGrid
                                            Orientation="Horizontal"
                                            ItemWidth="158"
                                            ItemHeight="118" />
                                    </ItemsPanelTemplate>
                                </GridView.ItemsPanel>

                            </GridView>

                        </Grid>

                    </Grid>

                </Grid>

                <!-- Status bar -->
                <Grid
                    Grid.Row="3"
                    Padding="12,0"
                    Background="Transparent">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="12"
                        VerticalAlignment="Center">

                        <TextBlock
                            x:Name="StatusText"
                            FontSize="10"
                            Foreground="#7FA5BA" />

                        <TextBlock
                            x:Name="SelectionStatusText"
                            FontSize="10"
                            Foreground="#A5CEE2" />

                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="7"
                        VerticalAlignment="Center">

                        <Button
                            x:Name="DetailsViewButton"
                            Style="{StaticResource AtlasExplorerTinyButtonStyle}"
                            Click="DetailsView_Click"
                            ToolTipService.ToolTip="Vue détaillée">
                            <FontIcon Glyph="&#xE8A0;" FontSize="11" />
                        </Button>

                        <Button
                            x:Name="CompactViewButton"
                            Style="{StaticResource AtlasExplorerTinyButtonStyle}"
                            Click="CompactView_Click"
                            ToolTipService.ToolTip="Vue compacte">
                            <FontIcon Glyph="&#xE8A1;" FontSize="11" />
                        </Button>

                        <Button
                            x:Name="IconViewButton"
                            Style="{StaticResource AtlasExplorerTinyButtonStyle}"
                            Click="IconView_Click"
                            ToolTipService.ToolTip="Vue icônes">
                            <FontIcon Glyph="&#xE8FD;" FontSize="11" />
                        </Button>

                    </StackPanel>

                </Grid>

</Grid>

        </Border>


        <!-- Window snap preview -->
        <Border
            x:Name="WindowSnapPreview"
            Visibility="Collapsed"
            IsHitTestVisible="False"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            CornerRadius="12"
            Background="#263FC9FF"
            BorderBrush="#6674DFFF"
            BorderThickness="1.5"
            Canvas.ZIndex="9000">

            <Border
                Margin="6"
                CornerRadius="8"
                BorderBrush="#285BC7F5"
                BorderThickness="1" />

        </Border>


        <!-- Atlas dock -->
        <Border
            x:Name="Dock"
            Margin="0,0,0,18"
            Padding="8"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            CornerRadius="22"
            Background="#D1151A26"
            BorderBrush="#568CB6D3"
            BorderThickness="1">

            <Grid ColumnSpacing="8">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Atlas Core -->
                <Button
                    x:Name="AtlasCoreButton"
                    Grid.Column="0"
                    Width="46"
                    Height="46"
                    Padding="0"
                    Click="Atlas_Click"
                    ToolTipService.ToolTip="Atlas Core"
                    Background="#35131E2C"
                    BorderBrush="#466A9DBD"
                    BorderThickness="1"
                    CornerRadius="15">

                    <Button.Flyout>

                        <Flyout
                            x:Name="AtlasCoreFlyout"
                            Placement="Top">

                            <Border
                                Width="300"
                                Padding="18"
                                CornerRadius="14"
                                Background="#FF141824"
                                BorderBrush="#455D7891"
                                BorderThickness="1">

                                <StackPanel Spacing="14">

                                    <Grid ColumnSpacing="12">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Grid
                                            Width="42"
                                            Height="42">

                                            <Ellipse
                                                Width="38"
                                                Height="38"
                                                Stroke="#3565B6E7"
                                                StrokeThickness="1" />

                                            <Ellipse
                                                Width="30"
                                                Height="30"
                                                Stroke="#7958D9FF"
                                                StrokeThickness="1.4" />

                                            <Ellipse
                                                Width="23"
                                                Height="23"
                                                Fill="#35143145"
                                                Stroke="#3D69D6FF"
                                                StrokeThickness="1" />

                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Text="A"
                                                FontSize="15"
                                                FontWeight="SemiBold"
                                                Foreground="#78DEFF" />

                                        </Grid>

                                        <StackPanel
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Spacing="2">

                                            <TextBlock
                                                Text="Atlas Core"
                                                FontSize="15"
                                                FontWeight="SemiBold"
                                                Foreground="#F0F8FF" />

                                            <StackPanel
                                                Orientation="Horizontal"
                                                Spacing="7">

                                                <Ellipse
                                                    x:Name="CoreDockFlyoutIndicator"
                                                    Width="7"
                                                    Height="7"
                                                    VerticalAlignment="Center"
                                                    Fill="#7A8593A0" />

                                                <TextBlock
                                                    x:Name="CoreDockStatusText"
                                                    Text="État inconnu"
                                                    FontSize="11"
                                                    Foreground="#A7BED0" />

                                            </StackPanel>

                                        </StackPanel>

                                    </Grid>

                                    <Border
                                        Height="1"
                                        Background="#285B7186" />

                                    <Button
                                        x:Name="CoreDockTestButton"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Padding="12,9"
                                        Click="AtlasTestCore_Click"
                                        Background="#251B2736"
                                        BorderBrush="#305D86A5"
                                        BorderThickness="1"
                                        CornerRadius="9">

                                        <StackPanel
                                            Orientation="Horizontal"
                                            Spacing="10">

                                            <FontIcon
                                                Glyph="&#xE721;"
                                                FontSize="15"
                                                Foreground="#8EDFFF" />

                                            <TextBlock
                                                Text="Tester la connexion"
                                                Foreground="#EDF8FF" />

                                        </StackPanel>

                                    </Button>

                                    <Grid ColumnSpacing="8">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Button
                                            x:Name="CoreDockStartButton"
                                            Grid.Column="0"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Padding="10,9"
                                            Click="AtlasStartCore_Click"
                                            Background="#25203A31"
                                            BorderBrush="#31579470"
                                            BorderThickness="1"
                                            CornerRadius="9">

                                            <StackPanel
                                                Orientation="Horizontal"
                                                Spacing="7">

                                                <FontIcon
                                                    Glyph="&#xE768;"
                                                    FontSize="14"
                                                    Foreground="#8CE8B0" />

                                                <TextBlock
                                                    Text="Démarrer"
                                                    Foreground="#EDF8FF" />

                                            </StackPanel>

                                        </Button>

                                        <Button
                                            x:Name="CoreDockStopButton"
                                            Grid.Column="1"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Padding="10,9"
                                            Click="AtlasStopCore_Click"
                                            Background="#282F2027"
                                            BorderBrush="#496F4A57"
                                            BorderThickness="1"
                                            CornerRadius="9">

                                            <StackPanel
                                                Orientation="Horizontal"
                                                Spacing="7">

                                                <FontIcon
                                                    Glyph="&#xE71A;"
                                                    FontSize="14"
                                                    Foreground="#F0A4AE" />

                                                <TextBlock
                                                    Text="Arrêter"
                                                    Foreground="#EDF8FF" />

                                            </StackPanel>

                                        </Button>

                                    </Grid>

                                </StackPanel>

                            </Border>

                        </Flyout>

                    </Button.Flyout>

                    <Grid>

                        <!-- halo sombre -->
                        <Ellipse
                            Width="36"
                            Height="36"
                            Fill="#151A2A3B"
                            Stroke="#285D99BF"
                            StrokeThickness="1" />

                        <!-- anneau externe -->
                        <Ellipse
                            Width="31"
                            Height="31"
                            Stroke="#4F5FCDF3"
                            StrokeThickness="1.2" />

                        <!-- anneau lumineux -->
                        <Ellipse
                            Width="25"
                            Height="25"
                            Stroke="#8858DCFF"
                            StrokeThickness="1.4" />

                        <!-- noyau -->
                        <Ellipse
                            Width="20"
                            Height="20"
                            Fill="#40102B3C"
                            Stroke="#356AD7FF"
                            StrokeThickness="1" />

                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Text="A"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="#7DE1FF" />

                        <!-- état Core -->
                        <Ellipse
                            x:Name="CoreDockIndicator"
                            Width="7"
                            Height="7"
                            Margin="0,0,4,4"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Fill="#7A8593A0"
                            Stroke="#FF101722"
                            StrokeThickness="1" />

                    </Grid>

                </Button>

                <Border
                    Grid.Column="1"
                    Margin="2,7"
                    Background="#345A7389" />

                <!-- Navigation principale -->
                <StackPanel
                    Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="6">

                    <Button
                        x:Name="DockFilesButton"
                        Width="46"
                        Height="46"
                        Padding="0"
                        Click="Files_Click"
                        ToolTipService.ToolTip="Fichiers"
                        Background="#2B182331"
                        BorderBrush="#34719EC2"
                        BorderThickness="1"
                        CornerRadius="15">

                        <Grid>

                            <FontIcon
                                Glyph="&#xE8B7;"
                                FontSize="20"
                                Foreground="#EAF7FF" />

                            <Ellipse
                                x:Name="DockFilesStateDot"
                                Width="5"
                                Height="5"
                                Margin="0,0,4,4"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Visibility="Collapsed"
                                Fill="#6ADFFF" />

                        </Grid>

                    </Button>

                    <Button
                        x:Name="DockWidgetsButton"
                        Width="46"
                        Height="46"
                        Padding="0"
                        Click="Widgets_Click"
                        ToolTipService.ToolTip="Widgets"
                        Background="#2B182331"
                        BorderBrush="#34719EC2"
                        BorderThickness="1"
                        CornerRadius="15">

                        <Grid>

                            <FontIcon
                                Glyph="&#xE80F;"
                                FontSize="18"
                                Foreground="#EAF7FF" />

                            <Ellipse
                                x:Name="DockWidgetsStateDot"
                                Width="5"
                                Height="5"
                                Margin="0,0,4,4"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Visibility="Collapsed"
                                Fill="#6ADFFF" />

                        </Grid>

                    </Button>

                    <Button
                        x:Name="DockSettingsButton"
                        Width="46"
                        Height="46"
                        Padding="0"
                        Click="Settings_Click"
                        ToolTipService.ToolTip="Paramètres"
                        Background="#2B182331"
                        BorderBrush="#34719EC2"
                        BorderThickness="1"
                        CornerRadius="15">

                        <Grid>

                            <FontIcon
                                Glyph="&#xE713;"
                                FontSize="18"
                                Foreground="#EAF7FF" />

                            <Ellipse
                                x:Name="DockSettingsStateDot"
                                Width="5"
                                Height="5"
                                Margin="0,0,4,4"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Visibility="Collapsed"
                                Fill="#6ADFFF" />

                        </Grid>

                    </Button>

                </StackPanel>

                <!-- Fenêtres réduites : la zone disparaît naturellement quand elle est vide -->
                <ScrollViewer
                    Grid.Column="3"
                    MaxWidth="260"
                    VerticalAlignment="Center"
                    VerticalScrollBarVisibility="Disabled"
                    HorizontalScrollBarVisibility="Hidden"
                    HorizontalScrollMode="Enabled"
                    VerticalScrollMode="Disabled"
                    ZoomMode="Disabled">

                    <StackPanel
                        x:Name="MinimizedWindowsHost"
                        Orientation="Horizontal"
                        Spacing="6" />

                </ScrollViewer>

                <Border
                    Grid.Column="4"
                    Margin="2,7"
                    Background="#345A7389" />

                <!-- Horloge -->
                <Border
                    Grid.Column="5"
                    MinWidth="94"
                    Padding="11,3"
                    VerticalAlignment="Stretch"
                    CornerRadius="14"
                    Background="#181D2835"
                    BorderBrush="#23597996"
                    BorderThickness="1">

                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="0">

                        <TextBlock
                            x:Name="ClockText"
                            HorizontalAlignment="Center"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="#F0F9FF" />

                        <TextBlock
                            x:Name="DateText"
                            HorizontalAlignment="Center"
                            FontSize="9"
                            Foreground="#83AEC8DD" />

                    </StackPanel>

                </Border>

                <Border
                    Grid.Column="6"
                    Margin="2,7"
                    Background="#345A7389" />

                <!-- Quitter -->
                <Button
                    Grid.Column="7"
                    Width="46"
                    Height="46"
                    Padding="0"
                    Click="ExitAtlas_Click"
                    ToolTipService.ToolTip="Quitter Atlas"
                    Background="#221A202D"
                    BorderBrush="#3B7896AE"
                    BorderThickness="1"
                    CornerRadius="15">

                    <FontIcon
                        Glyph="&#xE8BB;"
                        FontSize="18"
                        Foreground="#EDF8FF" />

                </Button>

            </Grid>

        </Border>

    </Grid>

</Window>
