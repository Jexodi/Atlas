<Window
    x:Class="Atlas.UI.Desktop.DesktopWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="Root">



        <Grid.Resources>

            <Style
                x:Key="AtlasWindowCaptionButtonStyle"
                TargetType="Button">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter
                    Property="BorderBrush"
                    Value="{StaticResource AtlasWindowInnerBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="7" />
            </Style>

            <!--
                WinUI 3 AcrylicBrush samples the app content itself.
                When several Atlas floating panels overlap, multiple
                acrylic layers therefore accumulate and progressively
                darken the visible window.

                The main Atlas window surface uses a fixed, opaque
                glass-look gradient instead. Internal cards and controls
                remain translucent, preserving the visual language while
                making the window appearance independent of how many
                Atlas windows are open.
            -->
            <LinearGradientBrush
                x:Key="AtlasWindowAcrylicBrush"
                StartPoint="0,0"
                EndPoint="1,1">

                <GradientStop
                    Color="#FF171925"
                    Offset="0" />

                <GradientStop
                    Color="#FF141722"
                    Offset="0.52" />

                <GradientStop
                    Color="#FF11141E"
                    Offset="1" />

            </LinearGradientBrush>

            <AcrylicBrush
                x:Key="AtlasSurfaceAcrylicBrush"
                TintColor="#222331"
                TintOpacity="0.34"
                TintLuminosityOpacity="0.20"
                FallbackColor="#D9222331" />

            <SolidColorBrush
                x:Key="AtlasWindowCardBrush"
                Color="#38282A3A" />

            <SolidColorBrush
                x:Key="AtlasWindowCardSoftBrush"
                Color="#24292B3B" />

            <SolidColorBrush
                x:Key="AtlasWindowControlBrush"
                Color="#49323543" />

            <SolidColorBrush
                x:Key="AtlasWindowBorderBrush"
                Color="#3C5B5E70" />

            <SolidColorBrush
                x:Key="AtlasWindowInnerBorderBrush"
                Color="#28585C6E" />

            <Style
                x:Key="AtlasDockButtonStyle"
                TargetType="Button">
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="40" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="#2C172231" />
                <Setter Property="BorderBrush" Value="#3471B9F0" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
            </Style>

            <Style
                x:Key="AtlasDockPrimaryButtonStyle"
                BasedOn="{StaticResource AtlasDockButtonStyle}"
                TargetType="Button">
                <Setter Property="Background" Value="#3B183047" />
                <Setter Property="BorderBrush" Value="#4F6CE2FF" />
            </Style>

            <Style
                x:Key="AtlasDockDangerButtonStyle"
                BasedOn="{StaticResource AtlasDockButtonStyle}"
                TargetType="Button">
                <Setter Property="Background" Value="#221A202D" />
                <Setter Property="BorderBrush" Value="#3D8DA7C0" />
            </Style>

            <Style
                x:Key="AtlasDockGroupBorderStyle"
                TargetType="Border">
                <Setter Property="Padding" Value="4" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Background" Value="#21172231" />
                <Setter Property="BorderBrush" Value="#235A7DA0" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            <Style
                x:Key="AtlasExplorerEntryButtonStyle"
                TargetType="Button">

                <Setter
                    Property="Padding"
                    Value="12,0" />

                <Setter
                    Property="HorizontalAlignment"
                    Value="Stretch" />

                <Setter
                    Property="HorizontalContentAlignment"
                    Value="Stretch" />

                <Setter
                    Property="VerticalContentAlignment"
                    Value="Center" />

                <Setter
                    Property="Background"
                    Value="#071B2734" />

                <Setter
                    Property="BorderBrush"
                    Value="#14779EBB" />

                <Setter
                    Property="BorderThickness"
                    Value="1" />

                <Setter
                    Property="CornerRadius"
                    Value="9" />

                <Setter
                    Property="Foreground"
                    Value="#E7F5FF" />

                <Setter Property="Template">

                    <Setter.Value>

                        <ControlTemplate
                            TargetType="Button">

                            <Border
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}">

                                <ContentPresenter
                                    Padding="{TemplateBinding Padding}"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    Foreground="{TemplateBinding Foreground}" />

                            </Border>

                        </ControlTemplate>

                    </Setter.Value>

                </Setter>

            </Style>


            <Style
                x:Key="AtlasSearchTextBoxStyle"
                TargetType="TextBox">

                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Hidden" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden" />

                <Setter Property="Template">

                    <Setter.Value>

                        <ControlTemplate TargetType="TextBox">

                            <Grid Background="Transparent">

                                <Border
                                    x:Name="BorderElement"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="0" />

                                <ScrollViewer
                                    x:Name="ContentElement"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center"
                                    HorizontalScrollMode="Auto"
                                    VerticalScrollMode="Disabled"
                                    HorizontalScrollBarVisibility="Hidden"
                                    VerticalScrollBarVisibility="Hidden"
                                    IsHorizontalRailEnabled="False"
                                    IsVerticalRailEnabled="False"
                                    IsDeferredScrollingEnabled="False"
                                    Padding="{TemplateBinding Padding}"
                                    Foreground="{TemplateBinding Foreground}"
                                    IsTabStop="False"
                                    ZoomMode="Disabled" />

                                <TextBlock
                                    x:Name="PlaceholderTextContentPresenter"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center"
                                    Padding="{TemplateBinding Padding}"
                                    Text="{TemplateBinding PlaceholderText}"
                                    TextAlignment="{TemplateBinding TextAlignment}"
                                    TextWrapping="NoWrap"
                                    Foreground="#99AFC3D2"
                                    IsHitTestVisible="False" />

                            </Grid>

                        </ControlTemplate>

                    </Setter.Value>

                </Setter>

            </Style>




            <Style


                x:Key="AtlasTelemetryProgressBarStyle"


                TargetType="ProgressBar">



                <Setter Property="Height" Value="4" />


                <Setter Property="Minimum" Value="0" />


                <Setter Property="Maximum" Value="100" />


                <Setter Property="Background" Value="#225A7185" />


                <Setter Property="Foreground" Value="#55C8FF" />



            </Style>



        </Grid.Resources>

        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF080B14" Offset="0.0" />
                <GradientStop Color="#FF111629" Offset="0.48" />
                <GradientStop Color="#FF07111C" Offset="1.0" />
            </LinearGradientBrush>
        </Grid.Background>

        <Canvas IsHitTestVisible="False" Opacity="0.42">

            <Ellipse
                Width="720"
                Height="720"
                Canvas.Left="-190"
                Canvas.Top="-270"
                Stroke="#2E6B78FF"
                StrokeThickness="3" />

            <Ellipse
                Width="920"
                Height="920"
                Canvas.Left="1020"
                Canvas.Top="-520"
                Stroke="#204ACBFF"
                StrokeThickness="2" />

            <Rectangle
                Width="1350"
                Height="2"
                Canvas.Left="-120"
                Canvas.Top="720"
                Fill="#1755C8FF">

                <Rectangle.RenderTransform>
                    <RotateTransform Angle="-21" />
                </Rectangle.RenderTransform>

            </Rectangle>

            <Border
                x:Name="NetworkWidgetCard"
                Tag="Network"
                PointerPressed="DesktopWidget_PointerPressed"
                PointerMoved="DesktopWidget_PointerMoved"
                PointerReleased="DesktopWidget_PointerReleased"
                PointerCanceled="DesktopWidget_PointerCanceled"
                Width="202"
                Padding="16,14"
                CornerRadius="16"
                Background="#34111A27"
                BorderBrush="#2D5DCBFF"
                BorderThickness="1">

                <StackPanel Spacing="10">

                    <Grid>

                        <TextBlock
                            Text="RÉSEAU"
                            VerticalAlignment="Center"
                            FontSize="9"
                            CharacterSpacing="130"
                            Foreground="#7CA8C2" />

                        <FontIcon
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Glyph="&#xE701;"
                            FontSize="13"
                            Foreground="#77D9FF" />

                    </Grid>

                    <TextBlock
                        x:Name="NetworkWidgetTypeText"
                        Text="--"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="#E7F5FF" />

                    <TextBlock
                        x:Name="NetworkWidgetAdapterText"
                        Text="--"
                        TextTrimming="CharacterEllipsis"
                        FontSize="10"
                        Foreground="#91AABD" />

                    <Grid ColumnSpacing="12">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="3">

                            <TextBlock
                                Text="↓ RÉCEPTION"
                                FontSize="9"
                                Foreground="#7899AD" />

                            <TextBlock
                                x:Name="NetworkWidgetDownloadText"
                                Text="--"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="#DDEEFF" />

                        </StackPanel>

                        <StackPanel
                            Grid.Column="1"
                            Spacing="3">

                            <TextBlock
                                Text="↑ ENVOI"
                                FontSize="9"
                                Foreground="#7899AD" />

                            <TextBlock
                                x:Name="NetworkWidgetUploadText"
                                Text="--"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="#DDEEFF" />

                        </StackPanel>

                    </Grid>

                    <Border
                        Height="1"
                        Background="#22576F84" />

                    <Grid>

                        <TextBlock
                            Text="IPv4"
                            FontSize="9"
                            Foreground="#7899AD" />

                        <TextBlock
                            x:Name="NetworkWidgetIpv4Text"
                            HorizontalAlignment="Right"
                            Text="--"
                            FontSize="10"
                            Foreground="#A8C6D6" />

                    </Grid>

                </StackPanel>

            </Border>

        </Canvas>

        <StackPanel
            Margin="32,26,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Spacing="2"
            IsHitTestVisible="False">

            <TextBlock
                Text="ATLAS"
                FontFamily="Segoe UI Variable"
                FontSize="18"
                FontWeight="SemiBold"
                CharacterSpacing="220"
                Foreground="#E7F5FF" />

            <TextBlock
                Text="DESKTOP"
                FontFamily="Segoe UI Variable"
                FontSize="9"
                CharacterSpacing="240"
                Foreground="#7CA8C2" />

        </StackPanel>

        <Canvas
            x:Name="DesktopWidgetsHost"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">

            <Border
                x:Name="CoreStatusCard"
                Tag="Core"
                PointerPressed="DesktopWidget_PointerPressed"
                PointerMoved="DesktopWidget_PointerMoved"
                PointerReleased="DesktopWidget_PointerReleased"
                PointerCanceled="DesktopWidget_PointerCanceled"
                Width="176"
                Padding="16,13"
                CornerRadius="16"
                Background="#34111A27"
                BorderBrush="#355DCBFF"
                BorderThickness="1">

                <StackPanel Spacing="4">
                    <TextBlock
                        Text="ATLAS"
                        FontSize="9"
                        CharacterSpacing="150"
                        Foreground="#7CA8C2" />

                    <TextBlock
                        x:Name="CoreStatusText"
                        Text="Core non connecté"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="#E7F5FF" />
                </StackPanel>

            </Border>

            <Border
                x:Name="SystemTelemetryCard"
                Tag="System"
                PointerPressed="DesktopWidget_PointerPressed"
                PointerMoved="DesktopWidget_PointerMoved"
                PointerReleased="DesktopWidget_PointerReleased"
                PointerCanceled="DesktopWidget_PointerCanceled"
                Width="202"
                Padding="16,14"
                CornerRadius="16"
                Background="#34111A27"
                BorderBrush="#2D5DCBFF"
                BorderThickness="1">

                <StackPanel Spacing="11">

                    <Grid>

                        <TextBlock
                            Text="SYSTÈME"
                            VerticalAlignment="Center"
                            FontSize="9"
                            CharacterSpacing="150"
                            Foreground="#7CA8C2" />

                        <Button
                            Width="25"
                            Height="25"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OpenSystemPanel_Click"
                            ToolTipService.ToolTip="Détails système">

                            <FontIcon
                                Glyph="&#xE72A;"
                                FontSize="11"
                                Foreground="#89CAE8" />

                        </Button>

                    </Grid>

                    <StackPanel Spacing="5">

                        <Grid>
                            <TextBlock
                                Text="CPU"
                                FontSize="10"
                                Foreground="#8DAFC2" />

                            <TextBlock
                                x:Name="CpuTelemetryText"
                                HorizontalAlignment="Right"
                                Text="-- %"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="#E7F5FF" />
                        </Grid>

                        <ProgressBar
                            x:Name="CpuTelemetryBar"
                            Style="{StaticResource AtlasTelemetryProgressBarStyle}" />

                    </StackPanel>

                    <StackPanel Spacing="5">

                        <Grid>
                            <TextBlock
                                Text="RAM"
                                FontSize="10"
                                Foreground="#8DAFC2" />

                            <TextBlock
                                x:Name="MemoryTelemetryText"
                                HorizontalAlignment="Right"
                                Text="-- %"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="#E7F5FF" />
                        </Grid>

                        <ProgressBar
                            x:Name="MemoryTelemetryBar"
                            Style="{StaticResource AtlasTelemetryProgressBarStyle}" />

                    </StackPanel>

                    <StackPanel Spacing="5">

                        <Grid>
                            <TextBlock
                                x:Name="DiskTelemetryLabel"
                                Text="DISQUE"
                                FontSize="10"
                                Foreground="#8DAFC2" />

                            <TextBlock
                                x:Name="DiskTelemetryText"
                                HorizontalAlignment="Right"
                                Text="-- %"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="#E7F5FF" />
                        </Grid>

                        <ProgressBar
                            x:Name="DiskTelemetryBar"
                            Style="{StaticResource AtlasTelemetryProgressBarStyle}" />

                    </StackPanel>

                    <Grid>
                        <TextBlock
                            Text="UPTIME"
                            FontSize="10"
                            Foreground="#8DAFC2" />

                        <TextBlock
                            x:Name="UptimeTelemetryText"
                            HorizontalAlignment="Right"
                            Text="--"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="#E7F5FF" />
                    </Grid>

                    <Grid>
                        <TextBlock
                            Text="RÉSEAU"
                            FontSize="10"
                            Foreground="#8DAFC2" />

                        <TextBlock
                            x:Name="NetworkTelemetryText"
                            HorizontalAlignment="Right"
                            Text="--"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="#E7F5FF" />
                    </Grid>

                </StackPanel>

            </Border>

            <Border
                x:Name="VoiceListeningCard"
                Tag="Voice"
                PointerPressed="DesktopWidget_PointerPressed"
                PointerMoved="DesktopWidget_PointerMoved"
                PointerReleased="DesktopWidget_PointerReleased"
                PointerCanceled="DesktopWidget_PointerCanceled"
                Width="202"
                Padding="16,14"
                CornerRadius="16"
                Background="#34111A27"
                BorderBrush="#2D5DCBFF"
                BorderThickness="1">

                <StackPanel Spacing="10">

                    <Grid>

                        <TextBlock
                            Text="VOIX &amp; ÉCOUTE"
                            VerticalAlignment="Center"
                            FontSize="9"
                            CharacterSpacing="130"
                            Foreground="#7CA8C2" />

                        <FontIcon
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Glyph="&#xE720;"
                            FontSize="13"
                            Foreground="#77D9FF" />

                    </Grid>

                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="8">

                        <Ellipse
                            x:Name="VoiceWidgetStateIndicator"
                            Width="8"
                            Height="8"
                            VerticalAlignment="Center"
                            Fill="#7A8593A0" />

                        <TextBlock
                            x:Name="VoiceWidgetStateText"
                            Text="En attente du Core"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="#E7F5FF" />

                    </StackPanel>

                    <TextBlock
                        x:Name="VoiceWidgetModeText"
                        Text="Mode d’écoute indisponible"
                        TextWrapping="Wrap"
                        FontSize="10"
                        Foreground="#91AABD" />

                    <Border
                        Height="1"
                        Background="#22576F84" />

                    <Grid>

                        <TextBlock
                            Text="MOT DE RÉVEIL"
                            FontSize="9"
                            Foreground="#7899AD" />

                        <TextBlock
                            x:Name="VoiceWidgetWakeWordText"
                            HorizontalAlignment="Right"
                            Text="Atlas"
                            FontSize="10"
                            FontWeight="SemiBold"
                            Foreground="#DDEEFF" />

                    </Grid>

                </StackPanel>

            </Border>

            <Border
                x:Name="StorageWidgetCard"
                Tag="Storage"
                PointerPressed="DesktopWidget_PointerPressed"
                PointerMoved="DesktopWidget_PointerMoved"
                PointerReleased="DesktopWidget_PointerReleased"
                PointerCanceled="DesktopWidget_PointerCanceled"
                Width="202"
                Padding="16,14"
                CornerRadius="16"
                Background="#34111A27"
                BorderBrush="#2D5DCBFF"
                BorderThickness="1">

                <StackPanel Spacing="10">

                    <Grid>

                        <TextBlock
                            Text="STOCKAGE ATLAS"
                            VerticalAlignment="Center"
                            FontSize="9"
                            CharacterSpacing="130"
                            Foreground="#7CA8C2" />

                        <FontIcon
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Glyph="&#xEDA2;"
                            FontSize="13"
                            Foreground="#77D9FF" />

                    </Grid>

                    <TextBlock
                        x:Name="StorageWidgetRootText"
                        Text="C:\AtlasData"
                        FontSize="13"
                        FontWeight="SemiBold"
                        TextTrimming="CharacterEllipsis"
                        Foreground="#E7F5FF" />

                    <ProgressBar
                        x:Name="StorageWidgetUsageBar"
                        Style="{StaticResource AtlasTelemetryProgressBarStyle}"
                        Value="0" />

                    <Grid>

                        <TextBlock
                            Text="UTILISÉ"
                            FontSize="9"
                            Foreground="#7899AD" />

                        <TextBlock
                            x:Name="StorageWidgetUsageText"
                            HorizontalAlignment="Right"
                            Text="--"
                            FontSize="10"
                            FontWeight="SemiBold"
                            Foreground="#DDEEFF" />

                    </Grid>

                    <Grid>

                        <TextBlock
                            Text="LIBRE"
                            FontSize="9"
                            Foreground="#7899AD" />

                        <TextBlock
                            x:Name="StorageWidgetFreeText"
                            HorizontalAlignment="Right"
                            Text="--"
                            FontSize="10"
                            FontWeight="SemiBold"
                            Foreground="#DDEEFF" />

                    </Grid>

                    <Grid>

                        <TextBlock
                            Text="VOLUME"
                            FontSize="9"
                            Foreground="#7899AD" />

                        <TextBlock
                            x:Name="StorageWidgetVolumeText"
                            HorizontalAlignment="Right"
                            Text="--"
                            FontSize="10"
                            Foreground="#A8C6D6" />

                    </Grid>

                </StackPanel>

            </Border>

        </Canvas>

        <!-- ===================================================== -->
        <!-- Atlas Widget Manager                                 -->
        <!-- ===================================================== -->

        <Border
            x:Name="WidgetManagerPanel"
            Width="760"
            Height="500"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="Collapsed"
            CornerRadius="10"
            Background="{StaticResource AtlasWindowAcrylicBrush}"
            BorderBrush="{StaticResource AtlasWindowBorderBrush}"
            BorderThickness="1"
            Padding="26"
            MinWidth="660"
            MinHeight="440"
            PointerPressed="FloatingPanel_PointerPressed"
            DoubleTapped="FloatingPanel_DoubleTapped">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="22" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>

                    <StackPanel Spacing="4">

                        <TextBlock
                            Text="WIDGETS"
                            FontSize="10"
                            CharacterSpacing="180"
                            Foreground="#69B8DC" />

                        <TextBlock
                            Text="Bureau Atlas"
                            FontSize="26"
                            FontWeight="SemiBold"
                            Foreground="#F1FAFF" />

                        <TextBlock
                            Text="Choisis les informations visibles directement sur le bureau."
                            FontSize="11"
                            Foreground="#9294A4" />

                    </StackPanel>

                    <StackPanel
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Orientation="Horizontal"
                        Spacing="6">

                        <Button
                            Style="{StaticResource AtlasWindowCaptionButtonStyle}"
                            Tag="WidgetManagerPanel"
                            Click="MinimizeFloatingPanel_Click"
                            ToolTipService.ToolTip="Réduire">
                            <FontIcon Glyph="&#xE921;" FontSize="12" Foreground="#D8D9E2" />
                        </Button>

                        <Button
                            Style="{StaticResource AtlasWindowCaptionButtonStyle}"
                            x:Name="WidgetsMaximizeButton"
                            Tag="WidgetManagerPanel"
                            Click="ToggleMaximizeFloatingPanel_Click"
                            ToolTipService.ToolTip="Agrandir">
                            <FontIcon Glyph="&#xE922;" FontSize="11" Foreground="#D8D9E2" />
                        </Button>

                        <Button
                            Style="{StaticResource AtlasWindowCaptionButtonStyle}"
                            Click="CloseWidgetManagerPanel_Click"
                            ToolTipService.ToolTip="Fermer">
                            <FontIcon Glyph="&#xE711;" FontSize="13" Foreground="#D8D9E2" />
                        </Button>

                    </StackPanel>

                </Grid>

                <ScrollViewer
                    Grid.Row="2"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">

                    <StackPanel Spacing="16">

                        <Border
                            Padding="20"
                            CornerRadius="8"
                            Background="{StaticResource AtlasWindowCardBrush}"
                            BorderBrush="{StaticResource AtlasWindowInnerBorderBrush}"
                            BorderThickness="1">

                            <StackPanel Spacing="14">

                                <TextBlock
                                    Text="WIDGETS ACTIFS"
                                    FontSize="9"
                                    CharacterSpacing="140"
                                    Foreground="#729FB7" />

                                <Grid ColumnSpacing="16">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Spacing="4">

                                        <TextBlock
                                            Text="Atlas Core"
                                            FontSize="15"
                                            FontWeight="SemiBold"
                                            Foreground="#EEF7FC" />

                                        <TextBlock
                                            Text="Affiche l’état de connexion du Core en permanence."
                                            TextWrapping="Wrap"
                                            FontSize="10"
                                            Foreground="#91AABD" />

                                    </StackPanel>

                                    <ToggleSwitch
                                        x:Name="WidgetCoreToggle"
                                        Grid.Column="1"
                                        IsOn="True"
                                        OnContent="Visible"
                                        OffContent="Masqué"
                                        Toggled="WidgetCoreToggle_Toggled" />

                                </Grid>

                                <Border
                                    Height="1"
                                    Background="#22576F84" />

                                <Grid ColumnSpacing="16">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Spacing="4">

                                        <TextBlock
                                            Text="Système"
                                            FontSize="15"
                                            FontWeight="SemiBold"
                                            Foreground="#EEF7FC" />

                                        <TextBlock
                                            Text="CPU, RAM, stockage, uptime et état réseau."
                                            TextWrapping="Wrap"
                                            FontSize="10"
                                            Foreground="#91AABD" />

                                    </StackPanel>

                                    <ToggleSwitch
                                        x:Name="WidgetSystemToggle"
                                        Grid.Column="1"
                                        IsOn="True"
                                        OnContent="Visible"
                                        OffContent="Masqué"
                                        Toggled="WidgetSystemToggle_Toggled" />

                                </Grid>

                                <Border
                                    Height="1"
                                    Background="#22576F84" />

                                <Grid ColumnSpacing="16">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Spacing="4">

                                        <TextBlock
                                            Text="Voix &amp; écoute"
                                            FontSize="15"
                                            FontWeight="SemiBold"
                                            Foreground="#EEF7FC" />

                                        <TextBlock
                                            Text="Mode d’écoute, mot de réveil et état de la session vocale."
                                            TextWrapping="Wrap"
